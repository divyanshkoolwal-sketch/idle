{
  "name": "idle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Idle — a real-time spot market where AI agents bid for GPU time from data centers. AUSD over x402, XRP over XRPL payment channels, XRPL Credentials as the trust layer.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev:exchange": "pnpm --filter @idle/exchange dev",
    "dev:facilitator": "pnpm --filter @idle/facilitator dev",
    "dev:dashboard": "pnpm --filter @idle/dashboard dev",
    "build:dashboard": "pnpm --filter @idle/dashboard build",
    "provider": "pnpm --filter @idle/provider start",
    "agent": "pnpm --filter @idle/agent start",
    "setup:wallets": "tsx scripts/setup-wallets.ts",
    "setup:fund": "tsx scripts/setup-fund.ts",
    "setup:ausd-domain": "tsx scripts/setup-ausd-domain.ts",
    "smoke:ausd-domain": "tsx scripts/smoke-ausd-domain.ts",
    "smoke:x402": "tsx scripts/smoke-x402.ts",
    "smoke:xrpl-cred": "tsx scripts/smoke-xrpl-cred.ts",
    "smoke:paychan": "tsx scripts/smoke-paychan.ts",
    "smoke:ollama": "tsx scripts/smoke-ollama.ts",
    "smoke:context": "tsx scripts/smoke-context.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@idle/pay-evm": "workspace:*",
    "@idle/pay-xrpl": "workspace:*",
    "@idle/shared": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "context.dev": "^3.5.0",
    "dotenv": "^16.4.5",
    "viem": "^2.57.4",
    "xrpl": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
